# Copy to .env (gitignored). Local development values only.
DATABASE_URL_MIGRATOR=postgres://crm_migrator:migrator_dev@127.0.0.1:5436/crm
DATABASE_URL_APP=postgres://crm_app:app_dev@127.0.0.1:5436/crm
BETTER_AUTH_SECRET=replace-with-32+-random-chars
BETTER_AUTH_URL=http://localhost:8787

# Meta Inbox (optional, development). Webhook ingress + worker + OAuth connect are off unless set.
# DATABASE_URL_INGEST=postgres://crm_ingest:ingest_dev@127.0.0.1:5436/crm
# DATABASE_URL_WORKER=postgres://crm_worker:worker_dev@127.0.0.1:5436/crm
# META_APP_ID=            # from the Meta app dashboard
# META_APP_SECRET=        # server-side only, never commit
# META_VERIFY_TOKEN=      # any random string; the same value goes into the Meta webhook setup
# META_FLFB_CONFIG_ID=    # Facebook Login for Business configuration id
# META_GRAPH_VERSION=v25.0
# META_OAUTH_REDIRECT_URI=http://localhost:3000/v1/integrations/meta/callback
# SECRETS_ENCRYPTION_KEY= # openssl rand -base64 32   (development key; KMS before external users)
# SECRETS_KEY_ID=dev1
# META_MOCK=1             # use the in-memory mock Graph (no Meta contact); needs the key, META_APP_SECRET and DATABASE_URL_WORKER
