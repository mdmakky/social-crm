# Copy to .env (gitignored). Local development values only.
DATABASE_URL_MIGRATOR=postgres://crm_migrator:migrator_dev@127.0.0.1:5436/crm
DATABASE_URL_APP=postgres://crm_app:app_dev@127.0.0.1:5436/crm
BETTER_AUTH_SECRET=replace-with-32+-random-chars
BETTER_AUTH_URL=http://localhost:8787

# Meta Inbox (optional, development). Webhook ingress + worker + OAuth connect are off unless set.
# DATABASE_URL_INGEST=postgres://crm_ingest:ingest_dev@127.0.0.1:5436/crm
# DATABASE_URL_WORKER=postgres://crm_worker:worker_dev@127.0.0.1:5436/crm
# META_APP_ID=            # from the Meta app dashboard
# META_APP_SECRET=        # server-side only, never commit
# META_VERIFY_TOKEN=      # any random string; the same value goes into the Meta webhook setup
# META_FLFB_CONFIG_ID=    # Facebook Login for Business configuration id
# META_GRAPH_VERSION=v25.0
# META_OAUTH_REDIRECT_URI=http://localhost:3000/v1/integrations/meta/callback
# Direct Instagram connection, no Facebook Page (Unified Login). Configuration id of a Facebook Login for Business configuration labelled "Instagram Login Compatible":
# META_IG_CONFIG_ID=
# META_IG_OAUTH_REDIRECT_URI=http://localhost:3000/v1/integrations/instagram/callback   # must be registered as a redirect URL for that configuration
# SECRETS_ENCRYPTION_KEY= # openssl rand -base64 32   (development key; KMS before external users)
# SECRETS_KEY_ID=dev1
# META_MOCK=1             # use the in-memory mock Graph (no Meta contact); needs the key, META_APP_SECRET and DATABASE_URL_WORKER

# Email support inbox (docs/integrations/email.md). MOCK unless MAIL_PROVIDER=mailgun, and Mailgun is UNVERIFIED (never called for real).
# MAIL_PROVIDER=file      # file (dev files, default) | mock (in-memory email channel, nothing is sent) | mailgun. Production refuses to start unless this is mailgun with the four keys below.
# MAILGUN_API_KEY=        # server-side only, never logged
# MAILGUN_SIGNING_KEY=    # the account Webhook Signing Key (Mailgun > Settings > API security), NOT the API key
# MAILGUN_DOMAIN=mg.example.com            # sending domain: replies go out as support@this
# EMAIL_INBOUND_DOMAIN=in.example.com      # customers write to support+<token>@this; its MX points at the provider
# MAILGUN_BASE_URL=https://api.eu.mailgun.net   # EU accounts only

# Free-tier hosting (docs/deploy/free-tier.md). Used by scripts/db-bootstrap-roles.mjs and the GitHub deploy workflow, not by the app itself.
# DATABASE_URL_ADMIN=          # owner/admin connection of the managed database (Neon), used once to create the four roles
# CRM_MIGRATOR_PASSWORD=       # 24+ random characters each, all different; never the *_dev passwords
# CRM_APP_PASSWORD=
# CRM_INGEST_PASSWORD=
# CRM_WORKER_PASSWORD=

# Inbox attachments (optional). No STORAGE_DRIVER = files are not kept: received media shows as metadata and uploads answer storage_not_configured.
# STORAGE_DRIVER=local            # local | s3 | none
# STORAGE_LOCAL_DIR=./.dev-blobs  # driver local: a directory the API may write (path-traversal safe, keys are built from ids only)
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # driver s3: R2, S3 or MinIO (path-style URLs)
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=               # server-side only, never commit, never logged
# S3_SECRET_ACCESS_KEY=
# ATTACHMENT_MAX_IMAGE_BYTES=5242880      # defaults: image 5 MB, audio 20 MB, video 25 MB, document 10 MB
# ATTACHMENT_ALLOWED_HOSTS=fbcdn.net,fbsbx.com,cdninstagram.com,whatsapp.net,facebook.com,instagram.com   # host suffixes a channel download may come from (default shown; UNVERIFIED)

# OpenRouter (optional). Attribution headers only; keys are per workspace in Settings > AI, never here.
# OPENROUTER_REFERER=https://your-app.example
# OPENROUTER_TITLE=Social CRM
# OPENROUTER_MOCK=1       # dev/e2e only: fixed offline model list and fake adapter; refused in production

# Google Gemini, speech to text only (voice messages). Optional. A workspace can paste its own key in Settings > AI > Setup (that key wins);
# GEMINI_API_KEY is an operator-wide key used when a workspace connects Gemini without pasting one. Server-side only, never logged or sent to the browser.
# Free-tier requests may be used by Google to improve its products: do not use a free key for real customer audio without reading its terms.
# GEMINI_API_KEY=
# GEMINI_TRANSCRIPTION_MODEL=gemini-2.5-flash   # default model for workspaces that connect with the server key (default: gemini-2.5-flash)

